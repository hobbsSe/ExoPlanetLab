# Run output (2 GB; results are reproducible from the jobs files)
Results/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# LaTeX build products (the .tex, .bib, class files and figures are tracked)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
texput.log

*.fls
*.fdb_latexmk
*.diff
*.bak_*

# Documents (user guide, analysis report, paper): the sources (.tex, .bib,
# class/style files, figures) are tracked in this development repository.
# Of the compiled PDFs only the user guide and the analysis report are
# tracked; the paper PDF is never committed. release_exclude.txt lists what
# is left out of the public release repository.
ExoPlanetLabDoc/*.pdf
!ExoPlanetLabDoc/ExoPlanetLab.pdf
ExoPlanetLabAnalysis/*.pdf
!ExoPlanetLabAnalysis/ExoPlanetLabAnalysis.pdf
ExoPlanetLabPaper/*.pdf
# journal PDFs and third-party documentation -- never commit
ExoPlanetLabPaper/Papers/
ExoPlanetLabPaper/bibtex/*.pdf
# Working notes: kept locally only
TODO.txt
# private correspondence -- never commit
ExoPlanetLabAnalysis/DPAC_*.txt

# Third-party material not ours to redistribute
# ESA DR4 pre-release data and tutorial (ESA licence)
data-release-4-tutorials/
# journal PDFs -- never commit
RVdata/Papers/

